<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    x:Class="IBEBarcode.Scanner.Views.AboutPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    Title="About">

    <ScrollView Padding="16">
        <VerticalStackLayout Spacing="14">

            <!--
                The IBE Group logo, at close to its native size: the artwork is 80x68, so drawing it much
                larger than this would only soften it.
            -->
            <Image
                Aspect="AspectFit"
                HorizontalOptions="Start"
                HeightRequest="64"
                WidthRequest="76"
                Source="ibegroup_logo.jpg" />

            <Label FontAttributes="Bold" FontSize="22" Text="{Binding Header}" />

            <Label FontSize="14" Text="{Binding Description}" />

            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" RowDefinitions="Auto,Auto" RowSpacing="4">
                <Label Grid.Row="0" Grid.Column="0" FontSize="13" Text="{Binding VersionLabel}" />
                <Label Grid.Row="0" Grid.Column="1" FontSize="13" Text="{Binding VersionValue}" />
                <Label Grid.Row="1" Grid.Column="0" FontSize="13" Text="{Binding LicenseLabel}" />
                <Label Grid.Row="1" Grid.Column="1" FontSize="13" Text="{Binding LicenseValue}" />
            </Grid>

            <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#D0D7DE, Dark=#3A3F45}" />

            <Label FontAttributes="Bold" FontSize="16" Text="{Binding LanguageTitle}" />
            <Picker
                ItemsSource="{Binding LanguageNames}"
                SelectedIndex="{Binding SelectedLanguageIndex}"
                Title="{Binding LanguageTitle}" />

            <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#D0D7DE, Dark=#3A3F45}" />

            <!--
                How to use the app: the About tab is the one place it explains itself, and the instructions
                are short enough to read in a single scroll rather than sitting behind another tap.
            -->
            <Label FontAttributes="Bold" FontSize="16" Text="{Binding HelpTitle}" />

            <VerticalStackLayout Spacing="10">
                <VerticalStackLayout Spacing="2">
                    <Label FontAttributes="Bold" FontSize="14" Text="{Binding HelpScanTitle}" />
                    <Label FontSize="13" Text="{Binding HelpScanText}" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="2">
                    <Label FontAttributes="Bold" FontSize="14" Text="{Binding HelpPhotoTitle}" />
                    <Label FontSize="13" Text="{Binding HelpPhotoText}" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="2">
                    <Label FontAttributes="Bold" FontSize="14" Text="{Binding HelpResultTitle}" />
                    <Label FontSize="13" Text="{Binding HelpResultText}" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="2">
                    <Label FontAttributes="Bold" FontSize="14" Text="{Binding HelpNfcTitle}" />
                    <Label FontSize="13" Text="{Binding HelpNfcText}" />
                </VerticalStackLayout>
                <VerticalStackLayout Spacing="2">
                    <Label FontAttributes="Bold" FontSize="14" Text="{Binding HelpTipsTitle}" />
                    <Label FontSize="13" Text="{Binding HelpTipsText}" />
                </VerticalStackLayout>
            </VerticalStackLayout>

            <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#D0D7DE, Dark=#3A3F45}" />

            <Label FontAttributes="Bold" FontSize="16" Text="{Binding CoverageTitle}" />
            <Label FontSize="13" Text="{Binding CoverageText}" />

            <Label FontAttributes="Bold" FontSize="16" Text="{Binding LimitationsTitle}" />
            <Label FontSize="13" Text="{Binding LimitationsText}" />

            <Label
                FontSize="12"
                Text="{Binding CompanionText}"
                TextColor="{AppThemeBinding Light=#57606A, Dark=#9BA3AD}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
